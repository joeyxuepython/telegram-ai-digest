# ==============================================
# Telegram AI Digest — Configuration Template
# Copy to config.yaml and fill in your values.
# cp config.yaml.example config.yaml
# ==============================================

telegram:
  # Prefer TELEGRAM_API_ID and TELEGRAM_API_HASH environment variables.
  # Do not put real credentials in this file.
  api_id: 0
  api_hash: ""

groups:
  # Chat IDs to monitor (find via @username_to_id_bot)
  - -1001234567890
  - -1009876543210

ai:
  provider: "openai"
  model: "gpt-4o-mini"
  # Set OPENAI_API_KEY in the environment. Never commit a key here.
  api_key: ""
  base_url: ""
  max_tokens: 2000
  temperature: 0.3

schedule:
  mode: "daily"                      # hourly | daily | weekly
  time: "20:00"                      # HH:MM (for daily/weekly)
  day: "monday"                      # for weekly mode

output:
  channels:
    - "console"                      # print to stdout
    # - "telegram"                   # send to your Saved Messages
    # - "webhook"                    # POST to a URL
  # webhook_url: "https://example.com/webhooks/digest"
  language: "zh"                     # en | zh | auto

storage:
  db_path: "./data/digests.db"       # SQLite database

server:
  host: "127.0.0.1"
  port: 8080
